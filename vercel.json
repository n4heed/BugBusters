{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "bugbusters-backend": {
      "root": "backend",
      "framework": "fastapi",
      "buildCommand": "pip install -r requirements.txt"
    },
    "bugbusters-frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "bugbusters-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "bugbusters-frontend"
      }
    }
  ]
}
