# Copy to .env and fill in locally. Never commit the real .env file.
# The deterministic pipeline works with everything below left blank/false.

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_ENABLED=false

# Hard limits enforced server-side (see backend/app/ai/config.py).
LLM_MAX_CALLS_PER_RUN=10
LLM_MAX_ALERTS_PER_INCIDENT=12
LLM_MAX_HISTORICAL_CASES=5
LLM_MAX_OUTPUT_TOKENS=1000
LLM_MAX_RETRIES=1
LLM_REQUEST_TIMEOUT_SECONDS=20
